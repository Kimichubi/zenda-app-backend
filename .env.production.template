### NODE ENV
NODE_ENV=production

### PORT
PORT=3001

### JWT (Generated with: openssl rand -hex 64)
# Generate fresh secrets for your deployment. Never reuse these examples.
JWT_ACCESS_SECRET=generate-with-openssl-rand-hex-64
JWT_REFRESH_SECRET=generate-with-openssl-rand-hex-64

### DATABASE (Cloud SQL via Unix socket or direct URL)
# For Cloud SQL: postgresql://USER:PASSWORD@/DB?host=/cloudsql/INSTANCE_CONNECTION_NAME
# For standalone: postgresql://USER:PASSWORD@HOST:5432/DB?schema=public
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?schema=public"

### REDIS (Cloud Memorystore or standalone)
# For Memorystore: redis://HOST:6379
REDIS_URL=redis://HOST:6379

### FRONTEND (CORS origin)
FRONTEND_URL=https://your-frontend-domain.com

### PIX Provider
PIX_PROVIDER=brcode

### WAHA (WhatsApp)
WHATSAPP_BASE_URL=http://waha:3000
WAHA_API_KEY=

### AI Provider: "gemini" | "qwen" | "default"
AI_PROVIDER=default

### AI (OpenRouter)
OPENROUTER_API_KEY=
OPENROUTER_API_URL=
OPENROUTER_MODEL=

### AI (Google Gemini)
GEMINAI_API_KEY=
GEMINAI_MODEL=

### AI (Qwen)
QWEN_API_KEY=
QWEN_API_URL=
QWEN_MODEL=
