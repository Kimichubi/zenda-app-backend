### NODE ENV
NODE_ENV=development

### PORT
PORT=3001

### JWT (Generate with: openssl rand -hex 64)
# IMPORTANT: Use strong random secrets in production. Never commit real secrets.
JWT_ACCESS_SECRET=change-me-to-a-secure-random-string-at-least-32-chars
JWT_REFRESH_SECRET=change-me-to-a-secure-random-string-at-least-32-chars

### DATABASE
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/postgres?schema=public"

### REDIS
REDIS_URL=redis://localhost:6380

### FRONTEND
FRONTEND_URL=http://localhost:5174

### PIX Provider (brcode | mercadopago | asaas | stripe | pagarme | gerencianet)
PIX_PROVIDER=brcode

### WAHA (WhatsApp)
WHATSAPP_BASE_URL=http://localhost:3002
WAHA_API_KEY=

### AI Provider: "gemini" | "qwen" | "default"
AI_PROVIDER=default

### AI (OpenRouter)
OPENROUTER_API_KEY=
OPENROUTER_API_URL=
OPENROUTER_MODEL=

### AI (Google Gemini)
GEMINAI_API_KEY=
GEMINAI_MODEL=

### AI (Qwen)
QWEN_API_KEY=
QWEN_API_URL=
QWEN_MODEL=

### SMTP (Email)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@zenda.com
