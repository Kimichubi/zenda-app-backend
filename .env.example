### NODE ENV
NODE_ENV=development

### PORT
PORT=3000

### JWT
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

### DATABASE
DATABASE_URL=""

## REDIS
REDIS_URL=redis://localhost:6379

### DOCKER
COMPOSE_PROJECT_NAME=zenda-app-backend


## FRONTEND
FRONTEND_URL=http://localhost:5173

## WAHA
WHATSAPP_BASE_URL=http://localhost:3001

WAHA_API_KEY=

WHATSAPP_SWAGGER_USERNAME=

WHATSAPP_SWAGGER_PASSWORD=

WAHA_DASHBOARD_USERNAME=

WAHA_DASHBOARD_PASSWORD=

### AI Provider: "qwen" | "gemini"
AI_PROVIDER=gemini

### AI (OpenRouter - Fallback)
OPENROUTER_API_KEY=
OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

### AI (Google Gemini)
GEMINAI_API_KEY=
GEMINAI_MODEL=gemini-2.0-flash