{
  "info": {
    "name": "Zenda Backend - Postman Collection",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "token", "value": "<JWT_TOKEN_HERE>" }
  ],
  "item": [
    {
      "name": "GET /",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/", "host": ["{{baseUrl}}"], "path": [""] }
      }
    },
    {
      "name": "POST /auth/signup",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Teste User\",\n  \"email\": \"teste@example.com\",\n  \"password\": \"password123\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/signup",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "signup"]
        }
      }
    },
    {
      "name": "POST /auth/login",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"teste@example.com\",\n  \"password\": \"password123\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "login"]
        }
      }
    },
    {
      "name": "POST /auth/refresh",
      "request": {
        "method": "POST",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": {
          "raw": "{{baseUrl}}/auth/refresh",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "refresh"]
        }
      }
    },
    {
      "name": "GET /users/me",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": {
          "raw": "{{baseUrl}}/users/me",
          "host": ["{{baseUrl}}"],
          "path": ["users", "me"]
        }
      }
    },
    {
      "name": "GET /schedules",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": {
          "raw": "{{baseUrl}}/schedules",
          "host": ["{{baseUrl}}"],
          "path": ["schedules"]
        }
      }
    },
    {
      "name": "POST /schedules",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"weekday\": 1,\n  \"startTime\": \"09:00\",\n  \"endTime\": \"17:00\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/schedules",
          "host": ["{{baseUrl}}"],
          "path": ["schedules"]
        }
      }
    },
    {
      "name": "GET /appointments",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": {
          "raw": "{{baseUrl}}/appointments",
          "host": ["{{baseUrl}}"],
          "path": ["appointments"]
        }
      }
    },
    {
      "name": "POST /appointments",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"clientId\": \"client-id-example\",\n  \"date\": \"2026-03-20T10:00:00.000Z\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/appointments",
          "host": ["{{baseUrl}}"],
          "path": ["appointments"]
        }
      }
    },
    {
      "name": "PATCH /appointments/:id",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"status\": \"CONFIRMED\"\n}" },
        "url": {
          "raw": "{{baseUrl}}/appointments/:id",
          "host": ["{{baseUrl}}"],
          "path": ["appointments", ":id"]
        }
      }
    },
    {
      "name": "GET /clients",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": {
          "raw": "{{baseUrl}}/clients",
          "host": ["{{baseUrl}}"],
          "path": ["clients"]
        }
      }
    },
    {
      "name": "POST /clients",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Cliente Exemplo\",\n  \"phone\": \"+5511999999999\",\n  \"email\": \"cliente@example.com\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/clients",
          "host": ["{{baseUrl}}"],
          "path": ["clients"]
        }
      }
    },
    {
      "name": "PATCH /clients/:id",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Cliente Atualizado\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/clients/:id",
          "host": ["{{baseUrl}}"],
          "path": ["clients", ":id"]
        }
      }
    },
    {
      "name": "DELETE /clients/:id",
      "request": {
        "method": "DELETE",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": {
          "raw": "{{baseUrl}}/clients/:id",
          "host": ["{{baseUrl}}"],
          "path": ["clients", ":id"]
        }
      }
    },
    {
      "name": "POST /payments/pix",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"appointmentId\": \"appointment-id-example\",\n  \"amount\": 100.5\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/payments/pix",
          "host": ["{{baseUrl}}"],
          "path": ["payments", "pix"]
        }
      }
    },
    {
      "name": "GET /dashboard/summary",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": {
          "raw": "{{baseUrl}}/dashboard/summary",
          "host": ["{{baseUrl}}"],
          "path": ["dashboard", "summary"]
        }
      }
    }
  ]
}
