generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Business {
  id             String         @id @default(uuid())
  ownerId        String         @unique
  owner          User           @relation("BusinessOwner", fields: [ownerId], references: [id])
  name           String
  slug           String         @unique
  pixKey         String?
  loyaltyConfig  LoyaltyConfig?
  staff          User[]         @relation("BusinessStaff")
  products       Product[]
  sales          Sale[]
  categories     Category[]
  reviews        Review[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model User {
  id              String         @id @default(uuid())
  name            String
  email           String         @unique
  passwordHash    String
  phone           String         @default("")
  businessName    String         @default("")
  slug            String         @unique @default("")
  role            UserRole       @default(USER)
  plan            UserPlan       @default(FREE)
  whatsappStatus  String         @default("DISCONNECTED")

  // Enterprise fields
  businessId      String?
  business        Business?      @relation("BusinessStaff", fields: [businessId], references: [id])
  ownedBusiness   Business?      @relation("BusinessOwner")
  baseCommission  Float          @default(0)

  // Pix Config
  pixKeyType      String?
  pixKey          String?
  pixName         String?
  pixCity         String?

  clients         Client[]
  appointments    Appointment[]
  commissions     Commission[]
  sales           Sale[]
  schedules       Schedule[]
  services        Service[]
  siteSettings    SiteSettings?
  createdAt       DateTime       @default(now())
}

enum UserRole {
  ADMIN
  MANAGER
  PROFESSIONAL
  USER
}

enum UserPlan {
  FREE
  PRO
  ENTERPRISE
}

model SiteSettings {
  id                String   @id @default(uuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  themeColor        String   @default("#000000")
  heroTitle         String   @default("Agende seu horário")
  heroSubtitle      String   @default("O melhor servico da regiao")
  aboutText         String   @default("Focados em excelencia e estilo.")
  logoUrl           String?
  instagramUrl      String?
  facebookUrl       String?
  whatsappUrl       String?

  // SEO fields
  metaTitle         String?
  metaDescription   String?
  city              String?
  state             String?
  googleBusinessUrl String?
  galleryPhotos     String[]

  // Bot / AI Settings
  botEnabled        Boolean  @default(true)
  botPrompt         String?  @db.Text
  botTone           String   @default("amigável")
  botUseEmojis      Boolean  @default(true)
  botMaxSentences   Int      @default(3)

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Service {
  id           String        @id @default(uuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  duration     Int
  price        Float
  createdAt    DateTime      @default(now())
  appointments Appointment[]

  @@index([userId])
}

model Client {
  id            String          @id @default(uuid())
  name          String
  phone         String
  email         String?
  notes         String?
  status        ClientStatus    @default(ACTIVE)
  userId        String
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  pointsBalance Int             @default(0)

  // New fields
  birthday      DateTime?
  avatarUrl     String?
  tags          String[]

  appointments  Appointment[]
  sales         Sale[]
  reviews       Review[]
  photos        ClientPhoto[]
  credit        ClientCredit?

  createdAt     DateTime        @default(now())

  @@index([userId])
}

enum ClientStatus {
  ACTIVE
  INACTIVE
}

model Product {
  id           String              @id @default(uuid())
  businessId   String
  business     Business            @relation(fields: [businessId], references: [id])
  name         String
  sku          String?
  price        Float
  costPrice    Float?
  stock        Int                 @default(0)
  minStock     Int                 @default(0)
  movements    InventoryMovement[]
  saleItems    SaleItem[]
  createdAt    DateTime            @default(now())
}

model InventoryMovement {
  id        String       @id @default(uuid())
  productId String
  product   Product      @relation(fields: [productId], references: [id])
  quantity  Int
  type      MovementType
  reason    String?
  createdAt DateTime     @default(now())
}

enum MovementType {
  IN
  OUT
}

model Sale {
  id             String            @id @default(uuid())
  businessId     String
  business       Business          @relation(fields: [businessId], references: [id])
  customerId     String?
  client         Client?           @relation(fields: [customerId], references: [id])
  sellerId       String
  seller         User              @relation(fields: [sellerId], references: [id])
  totalAmount    Float
  tipAmount      Float             @default(0)
  discountAmount Float             @default(0)
  paymentMethod  String
  status         String            @default("COMPLETED")
  splitConfig    Json?
  items          SaleItem[]
  commission     Commission?
  loyaltyPoints  Int               @default(0)
  splits         SplitTransaction[]
  createdAt      DateTime          @default(now())
}

model SaleItem {
  id        String  @id @default(uuid())
  saleId    String
  sale      Sale    @relation(fields: [saleId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  price     Float
}

model SplitTransaction {
  id            String   @id @default(uuid())
  saleId        String
  sale          Sale     @relation(fields: [saleId], references: [id])
  recipientId   String
  recipientType String
  amount        Float
  status        String   @default("PENDING")
  paidAt        DateTime?
  createdAt     DateTime @default(now())
}

model ClientCredit {
  id           String                   @id @default(uuid())
  clientId     String                   @unique
  client       Client                   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  balance      Float                    @default(0)
  transactions ClientCreditTransaction[]
  createdAt    DateTime                 @default(now())
}

model ClientCreditTransaction {
  id          String   @id @default(uuid())
  creditId    String
  credit      ClientCredit @relation(fields: [creditId], references: [id], onDelete: Cascade)
  amount      Float
  type        String
  saleId      String?
  description String
  createdAt   DateTime @default(now())
}

model Appointment {
  id                String            @id @default(uuid())
  clientId          String
  client            Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId            String
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  serviceId         String?
  service           Service?          @relation(fields: [serviceId], references: [id])
  date              DateTime
  startTime         String?
  endTime           String?
  price             Float?
  status            AppointmentStatus @default(SCHEDULED)

  // New fields
  notes             String?
  source            String            @default("WEB")
  rescheduleToken   String?           @unique
  rescheduleExpiry  DateTime?

  payment           Payment?
  commission        Commission?
  review            Review?
  photos            ClientPhoto[]
  createdAt         DateTime          @default(now())

  @@index([userId, date])
  @@index([clientId])
  @@index([rescheduleToken])
}

model Payment {
  id            String        @id @default(uuid())
  appointmentId String        @unique
  appointment   Appointment   @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  amount        Float
  status        PaymentStatus @default(PENDING)
  pixCode       String?
  reason        String?
  paidAt        DateTime?
  createdAt     DateTime      @default(now())

  @@index([status])
}

model Commission {
  id            String           @id @default(uuid())
  userId        String
  user          User             @relation(fields: [userId], references: [id])
  appointmentId String?          @unique
  appointment   Appointment?     @relation(fields: [appointmentId], references: [id])
  saleId        String?          @unique
  sale          Sale?            @relation(fields: [saleId], references: [id])
  amount        Float
  percentage    Float
  status        CommissionStatus @default(PENDING)
  paidAt        DateTime?
  createdAt     DateTime         @default(now())
}

enum CommissionStatus {
  PENDING
  PAID
  CANCELLED
}

model LoyaltyConfig {
  id              String   @id @default(uuid())
  businessId      String   @unique
  business        Business @relation(fields: [businessId], references: [id])
  pointsPerReal   Float    @default(1)
  minRedeemPoints Int      @default(100)
  active          Boolean  @default(true)
}

model Schedule {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekday      Int
  startTime    String
  endTime      String
  slotDuration Int      @default(30)
  breakStart   String?
  breakEnd     String?

  @@unique([userId, weekday])
}

model BlockedSlot {
  id        String   @id @default(uuid())
  userId    String
  date      DateTime
  startTime String
  endTime   String
  reason    String   @default("FOLGA")
  createdAt DateTime @default(now())

  @@index([userId, date])
}

model Category {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id])
  name       String
}

model Review {
  id                 String   @id @default(uuid())
  clientId           String
  client             Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  appointmentId      String   @unique
  appointment        Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  businessId         String
  business           Business @relation(fields: [businessId], references: [id])
  rating             Int
  comment            String?
  serviceRating      Int?
  professionalRating Int?
  isPublic           Boolean  @default(true)
  reply              String?
  replyAt            DateTime?
  createdAt          DateTime @default(now())

  @@index([businessId])
}

model ClientPhoto {
  id            String   @id @default(uuid())
  clientId      String
  client        Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])
  type          String   @default("GENERAL")
  url           String
  thumbnailUrl  String?
  description   String?
  takenAt       DateTime @default(now())
}

model ChatSession {
  id            String   @id @default(uuid())
  phoneNumber   String   @unique
  clientId      String?
  businessId    String?
  state         String   @default("IDLE")
  context       Json     @default("[]")
  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())

  logs ChatLog[]
}

model ChatLog {
  id          String   @id @default(uuid())
  sessionId   String
  session     ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  incoming    String
  outgoing    String
  intent      String
  confidence  Float
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now())

  @@index([sessionId])
  @@index([createdAt])
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum PaymentStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
  FAILED
}
